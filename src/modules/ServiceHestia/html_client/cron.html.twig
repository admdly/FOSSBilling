<div class="card-body">
    <h5 class="py-4">{% trans 'Cron Jobs' %}</h5>
    <table class="table card-table table-vcenter table-striped text-nowrap">
        <thead>
            <tr>
                <th>{% trans 'Command' %}</th>
                <th>{% trans 'Schedule' %}</th>
                <th class="w-1"></th>
            </tr>
        </thead>
        <tbody id="hestia-cron-list">
            <tr>
                <td colspan="3">
                    <div class="d-flex justify-content-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <h5 class="py-4">{% trans 'Add New Cron Job' %}</h5>
    <form id="hestia-add-cron-form" method="post" action="">
        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{% trans 'Command' %}</label>
            <div class="col">
                <input type="text" class="form-control" name="command" placeholder="/usr/bin/php /path/to/cron.php">
            </div>
        </div>
        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{% trans 'Schedule' %}</label>
            <div class="col">
                <div class="input-group">
                    <input type="text" class="form-control" name="min" placeholder="* (minute)">
                    <input type="text" class="form-control" name="hour" placeholder="* (hour)">
                    <input type="text" class="form-control" name="day" placeholder="* (day)">
                    <input type="text" class="form-control" name="month" placeholder="* (month)">
                    <input type="text" class="form-control" name="wday" placeholder="* (day of week)">
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">{% trans 'Add Cron Job' %}</button>
    </form>
</div>

<script>
$(function() {
    const orderId = {{ order.id }};

    function loadCronJobs() {
        bb.post(
            'client/servicehestia/list_cron_jobs',
            { order_id: orderId },
            function(result) {
                let html = '';
                if (Object.keys(result).length > 0) {
                    for (const jobId in result) {
                        const job = result[jobId];
                        const schedule = job.MIN + ' ' + job.HOUR + ' ' + job.DAY + ' ' + job.MONTH + ' ' + job.WDAY;
                        html += '<tr>';
                        html += '<td>' + job.CMD + '</td>';
                        html += '<td>' + schedule + '</td>';
                        html += '<td><a href="#" class="btn btn-danger delete-cron" data-job-id="' + jobId + '">{% trans "Delete" %}</a></td>';
                        html += '</tr>';
                    }
                } else {
                    html = '<tr><td colspan="3">{% trans "No cron jobs found" %}</td></tr>';
                }
                $('#hestia-cron-list').html(html);
            }
        );
    }

    $('#hestia-add-cron-form').on('submit', function(e) {
        e.preventDefault();
        const command = $(this).find('input[name="command"]').val();
        const min = $(this).find('input[name="min"]').val();
        const hour = $(this).find('input[name="hour"]').val();
        const day = $(this).find('input[name="day"]').val();
        const month = $(this).find('input[name="month"]').val();
        const wday = $(this).find('input[name="wday"]').val();
        const schedule = [min, hour, day, month, wday].join(' ');

        bb.post(
            'client/servicehestia/add_cron_job',
            { order_id: orderId, command: command, schedule: schedule },
            function(result) {
                bb.msg('{% trans "Cron job added successfully" %}');
                loadCronJobs();
                $('#hestia-add-cron-form')[0].reset();
            }
        );
    });

    $('#hestia-cron-list').on('click', '.delete-cron', function(e) {
        e.preventDefault();
        const jobId = $(this).data('job-id');
        if (confirm('{% trans "Are you sure you want to delete this cron job?" %}')) {
            bb.post(
                'client/servicehestia/delete_cron_job',
                { order_id: orderId, job_id: jobId },
                function(result) {
                    bb.msg('{% trans "Cron job deleted successfully" %}');
                    loadCronJobs();
                }
            );
        }
    });

    loadCronJobs();
});
</script>
